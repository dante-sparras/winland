<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    version.ps1 prints 0.1.<commits on HEAD>. Pass that as Version when packing.
    An unpacked build is 0.0.0-dev. Projects are not packable unless they opt in.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <IsPackable>false</IsPackable>
    <Authors>dante-sparras</Authors>
  </PropertyGroup>
</Project>
