<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Winland.Core\Winland.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    For mutation testing. Stryker compiles each mutant itself and runs CsWin32 in-process, so CsWin32
    must find its inputs without the build: NativeMethods.txt by a full path (Stryker reads it from its
    own folder), and the metadata paths as properties set at evaluation. The build sets those in a
    target, so scripts/mutate.ps1 asks MSBuild for them and passes them in through the environment.
    Elsewhere they are empty here and the CsWin32 target fills them in as before.
  -->
  <ItemGroup>
    <AdditionalFiles Remove="NativeMethods.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)NativeMethods.txt" />
  </ItemGroup>

  <PropertyGroup>
    <CsWin32InputMetadataPaths>$(CsWin32InputMetadataPaths)</CsWin32InputMetadataPaths>
    <CsWin32InputDocPaths>$(CsWin32InputDocPaths)</CsWin32InputDocPaths>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SHAppBarMessage's struct is pointer-sized, so CsWin32 will not emit it for AnyCPU. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

</Project>
