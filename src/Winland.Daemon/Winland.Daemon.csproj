<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AssemblyName>winland</AssemblyName>
    <RootNamespace>Winland</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winland.Core\Winland.Core.csproj" />
    <ProjectReference Include="..\Winland.Install\Winland.Install.csproj" />
    <ProjectReference Include="..\Winland.Windows\Winland.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="winland.default.conf">
      <LogicalName>winland.default.conf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Daemon.Tests" />
  </ItemGroup>

</Project>
