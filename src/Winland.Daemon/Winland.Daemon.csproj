<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AssemblyName>winland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupHookSupport>false</StartupHookSupport>
    <!-- A release is published for a runtime, and compiled ahead then, so neither a `winland dispatch` nor the first
         key a session sees waits on the JIT. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winland.Install\Winland.Install.csproj" />
    <ProjectReference Include="..\Winland.Infrastructure\Winland.Infrastructure.csproj" />
    <Using Include="Winland.Domain" />
    <Using Include="Winland.Domain.Monitor" Alias="Monitor" />
    <Using Include="Winland.Application" />
    <Using Include="Winland.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="winland.default.conf">
      <LogicalName>winland.default.conf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Daemon.Tests" />
  </ItemGroup>

  <Target Name="PublishLauncher" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\Winland.Launcher\Winland.Launcher.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(PublishDir);SelfContained=true" />
  </Target>

</Project>
