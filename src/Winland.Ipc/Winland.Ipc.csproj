<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winland.Ipc</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- winoma.exe and winland.exe are native. This contract is what they both link. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Tests" />
  </ItemGroup>

  <!--
    The handshake compares this stamp. It is a hash of the contract sources (ProtocolStamp), not the git commit,
    so two builds that speak the same protocol connect and a change to a message kind or its shape refuses.
    protocol-stamp.ps1 must hash the same files, in the same order, the same way ProtocolStamp.Hash does.
  -->
  <Target Name="WriteBuildStamp" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\protocol-stamp.ps1&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="WinlandStamp" />
    </Exec>
    <PropertyGroup>
      <!-- powershell writes a newline after the hash. A newline inside the generated string does not compile. -->
      <WinlandStamp>$([System.String]::Copy('$(WinlandStamp)').Trim())</WinlandStamp>
    </PropertyGroup>
    <Error Condition="'$(WinlandStamp)' == '' Or $([System.String]::Copy('$(WinlandStamp)').Length) != 64" Text="The protocol stamp was not a 64-character hash of the Winland.Ipc contract." />
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildStamp.g.cs" Overwrite="true" Lines="namespace Winland.Ipc%3B public static partial class BuildStamp { private const string Stamp = &quot;$(WinlandStamp)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildStamp.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildStamp.g.cs" />
    </ItemGroup>
  </Target>
</Project>
