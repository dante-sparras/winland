<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winland.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- winoma.exe is native code. Core code it can reach must not need reflection. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Tests" />
    <!-- The shell still calls the session's minimum-size bookkeeping. It was internal while both lived in one assembly. -->
    <InternalsVisibleTo Include="Winoma.Core" />
  </ItemGroup>
</Project>
