<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>winland</AssemblyName>
    <RootNamespace>Winland.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A publish is native code, so a call starts in milliseconds. A build stays managed. The name is winland.exe, not Winland.exe: NTFS folds those into one file, and Winland.Host.exe is the window manager. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Winland.Ipc\Winland.Ipc.csproj" />
  </ItemGroup>
</Project>
