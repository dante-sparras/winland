<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Winland.Windows\Winland.Windows.csproj" />
    <ProjectReference Include="..\Winland.FocusThief\Winland.FocusThief.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="WriteFocusThiefPath" AfterTargets="Build">
    <PropertyGroup>
      <_Thief>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Winland.FocusThief\bin\$(Configuration)\net10.0-windows10.0.17763.0\Winland.FocusThief.exe'))</_Thief>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)focus-thief.path" Lines="$(_Thief)" Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
