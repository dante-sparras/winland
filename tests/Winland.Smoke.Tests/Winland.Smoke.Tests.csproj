<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Winland.Daemon\Winland.Daemon.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="WriteSmokePaths" AfterTargets="Build">
    <PropertyGroup>
      <_Daemon>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Winland.Daemon\bin\$(Configuration)\net10.0-windows10.0.22621.0\winland.exe'))</_Daemon>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)smoke.paths" Lines="$(_Daemon)" Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
