<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);SamplePlugin/**;SampleRepository/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Copied as source: the install test clones it into a git repository and builds it. -->
  <ItemGroup>
    <None Include="SampleRepository/**" Exclude="SampleRepository/**/bin/**;SampleRepository/**/obj/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Winland.Core\Winland.Core.csproj" />
    <ProjectReference Include="..\..\src\Winland.PluginApi\Winland.PluginApi.csproj" />
    <ProjectReference Include="..\..\src\Winland.Plugins\Winland.Plugins.csproj" />
    <ProjectReference Include="SamplePlugin\SamplePlugin.csproj" />
  </ItemGroup>

</Project>
